# manuscript/config.yaml.example — HERACLES copy-and-customize template
# Copy to manuscript/config.yaml and adjust paper/film metadata.
# The single source of truth for tokens consumed by
# src/no_time_to_die/manuscript_variables.py::generate_variables().

paper:
  title: "No Time to Die: HERACLES — Special-Agent Mission Software"
  subtitle: "DNA-Targeted Bioweapon Countermeasure, Poison-Garden Toxicology, and Poison-Delivery Forensics"
  version: "1.0.0"
  date: "2026-08-04"

film:
  slug: "no_time_to_die"
  codename: "HERACLES"

authors:
  - name: "Daniel Ari Friedman"
    orcid: "0000-0001-6232-9096"
    email: "daniel@activeinference.institute"
    affiliation: "Active Inference Institute"
    corresponding: true

keywords:
  - "DNA-targeted bioweapon countermeasure"
  - "poison-garden toxicology"
  - "poison delivery forensics"
  - "deterministic modelling"

metadata:
  license: "MIT"
  language: "en"

demo:
  seed: 11
  max_mismatches: 2
  absorption_rate: 1.2
  exposure_time: 4.0
  avidity: 3.0
  lod_snr: 3.0
  antagonist_conc: 10.0
  exposure:
    concentration: 0.02
    contact_rate: 0.5
    duration: 30.0
    absorption_fraction: 0.2
    elimination_rate: 0.1
    noael: 0.5
    reference_dose: 0.001
